            "kind": "text",
            "text": "Optional OpenAI organization/project selection for an API-key authentication probe."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "These selectors must match the host's later inference-client configuration. They do\nnot change the fixed OpenAI endpoint, grant permissions or select a model. Construction\ncaptures detached values; subsequent mutations of the supplied object have no effect."
              }
            ]
          }
        ]
      },
