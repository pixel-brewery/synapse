    {
      "id": 1,
      "name": "OpenAiApiKeyVerifier",
      "variant": "declaration",
      "kind": 128,
      "flags": {
        "isPublic": true
      },
      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "Verifies an OpenAI API key through its authenticated, non-inference models endpoint."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Sends one GET to https://api.openai.com/v1/models without generating tokens or\nreturning the model catalog. Acceptance proves access to this endpoint only; it does not\nestablish model entitlement, billing readiness or available budget. A restricted key without\nmodel-list permission cannot be verified by this adapter. Keys remain backend-only secrets.\nImports and construction neither access credentials nor perform network I/O."
              }
            ]
          }
        ]
      },
