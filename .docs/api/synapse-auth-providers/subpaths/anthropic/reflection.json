            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Keys that can select multiple workspaces require a workspace ID. The selected\nworkspace must match the application's later inference-client configuration. A key already\nscoped to one workspace can omit this option. The supplied value is captured at construction."
              }
            ]
          }
