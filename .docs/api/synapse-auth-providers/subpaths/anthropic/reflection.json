      "id": 1,
      "name": "AnthropicApiKeyVerifier",
      "variant": "declaration",
      "kind": 128,
      "flags": {
        "isPublic": true
      },
      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "Verifies an Anthropic API key through its authenticated, non-inference models endpoint."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Sends one GET to https://api.anthropic.com/v1/models?limit=1 using the documented\n2026-10-21 API version and bearer-key authentication. No model generation, catalog export,\nbilling check or entitlement claim occurs. Keys without permission for this endpoint cannot\nbe verified by this adapter. Construction and imports perform no credential or network I/O."
              }
            ]
          }
        ]
      },
