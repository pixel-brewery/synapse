        "summary": [
          {
            "kind": "text",
            "text": "Replaceable backend boundary for bounded provider authentication GET requests."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Construction and imports must remain inert. Implementations own endpoint validation,\nsecret headers, response bounds and cancellation through awaited connection cleanup. They must\nnever invoke a model, follow redirects carrying credentials, retry or expose raw transport errors."
              }
            ]
          }
        ]
      },
