    {
      "id": 7,
      "name": "NodeApiKeyVerificationTransport",
      "variant": "declaration",
      "kind": 128,
      "flags": {
        "isPublic": true
      },
      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "Bounded Node.js HTTPS transport for provider authentication and account metadata only."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Every call uses GET, a fresh direct connection and normal TLS certificate verification.\nPublic DNS answers are validated at connection time and pinned to that connection; private,\nreserved and mixed public/private answers are rejected. Credentials stay in headers. Redirects,\ncompressed responses, automatic retries and ambient proxy configuration are not used. A request\nsettles only after its owned request, response and socket have closed. Imports and construction\nperform no DNS lookup, network request, timer registration or environment capture."
              }
            ]
          }
        ]
      },
      "children": [
