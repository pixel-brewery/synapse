  "comment": {
    "summary": [
      {
        "kind": "text",
        "text": "Shared HTTP boundary for optional provider API-key authentication checks.\n\nImport concrete verifiers from the openai, anthropic, gemini, mistral or openrouter subpath.\nModel execution belongs to the consuming application's Vercel AI SDK integration."
      }
    ]
  },
