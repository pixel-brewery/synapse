          "variant": "declaration",
          "kind": 1024,
          "flags": {
            "isOptional": true,
            "isReadonly": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Maximum uncompressed response bytes retained or read; default 1 MiB.\nCompressed responses are rejected instead of being decompressed."
              }
            ]
          },
          "type": {
            "type": "intrinsic",
            "name": "number"
          }
        },
        {
          "id": 50,
          "name": "timeoutMs",
          "variant": "declaration",
          "kind": 1024,
          "flags": {
            "isOptional": true,
            "isReadonly": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Total lifetime including DNS, connection and response; default 5,000 milliseconds.\nMust be a positive safe integer within Node.js's timer ceiling."
              }
            ]
          },
          "type": {
            "type": "intrinsic",
            "name": "number"
          }
        }
