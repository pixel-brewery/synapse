      "children": [
        {
          "id": 52,
          "name": "maximumConcurrentRequests",
          "variant": "declaration",
          "kind": 1024,
          "flags": {
            "isOptional": true,
            "isReadonly": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Maximum requests owned concurrently by this transport; default 64.\nExcess requests reject immediately instead of joining an unbounded queue.\nA non-cancellable OS DNS lookup retains its slot until its callback completes,\nincluding after the caller has already timed out or cancelled."
              }
            ]
          },
          "type": {
            "type": "intrinsic",
            "name": "number"
          }
        },
        {
          "id": 51,
