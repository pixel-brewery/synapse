{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "defaultBase": "main",
    "tui": {
        "enabled": false
    },
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "!{projectRoot}/dist/**/*",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/package.json"
        ],
        "production": ["default", "!{projectRoot}/**/*.spec.ts"]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "cache": true,
            "inputs": ["production", "^production"]
        },
        "test": {
            "cache": true,
            "inputs": ["default", "^production"],
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "lint": {
            "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
            "cache": true
        },
        "nx-release-publish": {
            "executor": "@nx/js:release-publish",
            "dependsOn": ["build"],
            "options": {
                "packageRoot": "{projectRoot}",
                "registry": "https://npm.pkg.github.com"
            }
        }
    },
    "release": {
        "groups": {
            "synapse": {
                "projects": [
                    "synapse-core",
                    "synapse-runtime",
                    "synapse-auth",
                    "synapse-routing",
                    "synapse-provider-codex",
                    "synapse-provider-claude",
                    "synapse-provider-opencode",
                    "synapse-provider-acp",
                    "synapse-testing",
                    "synapse-mcp"
                ],
                "projectsRelationship": "fixed"
            }
        },
        "version": {
            "currentVersionResolver": "git-tag",
            "fallbackCurrentVersionResolver": "disk",
            "preserveLocalDependencyProtocols": false,
            "preserveMatchingDependencyRanges": false,
            "adjustSemverBumpsForZeroMajorVersion": false,
            "updateDependents": "never",
            "versionActionsOptions": {
                "installIgnoreScripts": true
            }
        },
        "changelog": {
            "workspaceChangelog": {
                "createRelease": false,
                "file": "{workspaceRoot}/CHANGELOG.md"
            },
            "projectChangelogs": false,
            "automaticFromRef": true
        },
        "git": {
            "commit": true,
            "commitMessage": "chore(release): publish {version} [skip ci]",
            "tag": true,
            "push": false
        },
        "releaseTag": {
            "pattern": "v{version}"
        }
    },
    "parallel": 1,
    "affected": {
        "legacy": true
    }
}
