{
    "name": "synapse-mcp",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "tools/mcp/src",
    "tags": ["scope:tooling"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["api-docs"],
                    "target": "check"
                }
            ],
            "inputs": [
                "production",
                "{workspaceRoot}/.docs/**/*",
                "{workspaceRoot}/libs/**/README.md",
                "{workspaceRoot}/libs/**/package.json",
                "{workspaceRoot}/LICENSE"
            ],
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "command": "yarn workspace @pixel-brewery/synapse-mcp build"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "yarn workspace @pixel-brewery/synapse-mcp typecheck"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "yarn workspace @pixel-brewery/synapse-mcp lint"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "inputs": [
                "default",
                "{workspaceRoot}/.docs/**/*",
                "{workspaceRoot}/libs/**/README.md",
                "{workspaceRoot}/libs/**/package.json",
                "{workspaceRoot}/yarn.lock"
            ],
            "options": {
                "command": "yarn workspace @pixel-brewery/synapse-mcp test"
            }
        }
    }
}
