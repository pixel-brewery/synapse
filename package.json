{
    "name": "@pixel-brewery/synapse-workspace",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "license": "MIT",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24.15.0"
    },
    "workspaces": [
        "libs/*",
        "apps/*",
        "tools/mcp"
    ],
    "scripts": {
        "nx": "nx",
        "build": "nx run-many -t build --parallel=1",
        "test": "nx run-many -t test --parallel=1",
        "typecheck": "nx run-many -t typecheck --parallel=1",
        "lint": "nx run-many -t lint --parallel=1",
        "format": "prettier --write . && node tools/formatSourceLayout.mjs --write && prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "yarn run format && yarn run lint && yarn run test",
        "update": "yarn upgrade-interactive",
        "spell": "cspell --gitignore .",
        "verify": "yarn agents:check && yarn format:check && yarn lint && yarn spell && yarn typecheck && yarn test && yarn build && yarn docs:check",
        "agents:sync": "node tools/sync-agents.mjs --write",
        "agents:check": "nx run agent-tooling:check",
        "agents:upstream": "node tools/check-architect-origin.mjs",
        "docs": "nx run api-docs:generate --parallel=1",
        "docs:check": "nx run api-docs:check --parallel=1",
        "source:check": "node tools/formatSourceLayout.mjs --check && node tools/check-source.mjs",
        "docs:api": "nx run api-docs:generate --parallel=1",
        "agents:verify": "yarn agents:check && yarn nx run agent-tooling:test && yarn nx run api-docs:test && yarn docs:check",
        "packaging:verify": "nx run packaging:verify --parallel=1",
        "native:verify": "yarn build && node tools/verifyNativeProvider.mjs",
        "release": "gh workflow run release.yml --ref main -f specifier=patch",
        "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
        "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
        "release:major": "gh workflow run release.yml --ref main -f specifier=major",
        "release:local": "node tools/releaseLocal.mjs patch",
        "release:patch:local": "node tools/releaseLocal.mjs patch",
        "release:minor:local": "node tools/releaseLocal.mjs minor",
        "release:major:local": "node tools/releaseLocal.mjs major",
        "release:dry-run:local": "node tools/releaseLocal.mjs patch --dry-run",
        "release:nx": "nx release --skip-publish",
        "release:dry-run": "nx release --skip-publish --dry-run",
        "release:publish": "yarn build && node tools/publishPackages.mjs",
        "release:verify": "node tools/verifyPublishedPackages.mjs"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@eslint/js": "10.0.1",
        "@nx/js": "24.0.2",
        "@nx/workspace": "24.0.2",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@swc/helpers": "~0.5.23",
        "@types/node": "26.6.6",
        "@yarnpkg/cli-dist": "4.18.1",
        "cspell": "10.4.0",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "nx": "24.0.2",
        "prettier": "3.9.10",
        "rollup": "4.66.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.14.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    },
    "description": "Modular TypeScript runtime for installed AI CLIs: native auth, isolated profiles, sessions and policy-controlled routing.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixel-brewery/synapse.git"
    },
    "homepage": "https://github.com/pixel-brewery/synapse#readme",
    "bugs": {
        "url": "https://github.com/pixel-brewery/synapse/issues"
    }
}
