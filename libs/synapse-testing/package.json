{
    "name": "@pixel-brewery/synapse-testing",
    "version": "0.0.4",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "!**/*.tsbuildinfo"
    ],
    "nx": {
        "name": "synapse-testing"
    },
    "dependencies": {
        "@pixel-brewery/synapse-core": "^0.0.4",
        "@pixel-brewery/synapse-runtime": "^0.0.4"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.15.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "description": "Simulated AI drivers and process transport replays for account-free Synapse integration tests.",
    "scripts": {
        "build": "tsc --build tsconfig.lib.json",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
        "lint": "eslint src",
        "test": "vitest run --config vitest.config.ts"
    },
    "keywords": [
        "ai",
        "cli",
        "typescript",
        "testing",
        "fixtures",
        "synapse"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixel-brewery/synapse.git",
        "directory": "libs/synapse-testing"
    },
    "homepage": "https://github.com/pixel-brewery/synapse#packages",
    "bugs": {
        "url": "https://github.com/pixel-brewery/synapse/issues"
    }
}
