{
    "name": "@pixel-brewery/synapse-auth-providers",
    "version": "0.0.12",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./openai": {
            "types": "./dist/openai/index.d.ts",
            "import": "./dist/openai/index.js"
        },
        "./anthropic": {
            "types": "./dist/anthropic/index.d.ts",
            "import": "./dist/anthropic/index.js"
        },
        "./gemini": {
            "types": "./dist/gemini/index.d.ts",
            "import": "./dist/gemini/index.js"
        },
        "./mistral": {
            "types": "./dist/mistral/index.d.ts",
            "import": "./dist/mistral/index.js"
        },
        "./openrouter": {
            "types": "./dist/openrouter/index.d.ts",
            "import": "./dist/openrouter/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "!**/*.tsbuildinfo"
    ],
    "nx": {
        "name": "synapse-auth-providers"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.15.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "description": "Optional non-inference API-key verification for OpenAI, Anthropic, Gemini, Mistral and OpenRouter.",
    "scripts": {
        "build": "tsc --build tsconfig.lib.json",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
        "lint": "eslint src",
        "test": "vitest run --config vitest.config.ts"
    },
    "keywords": [
        "ai",
        "typescript",
        "authentication",
        "api-key",
        "synapse"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixel-brewery/synapse.git",
        "directory": "libs/synapse-auth-providers"
    },
    "homepage": "https://github.com/pixel-brewery/synapse#packages",
    "bugs": {
        "url": "https://github.com/pixel-brewery/synapse/issues"
    },
    "dependencies": {
        "@pixel-brewery/synapse-auth": "^0.0.12",
        "@pixel-brewery/synapse-core": "^0.0.12"
    }
}
