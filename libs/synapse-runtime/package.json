{
    "name": "@pixel-brewery/synapse-runtime",
    "version": "0.0.4",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "!**/*.tsbuildinfo"
    ],
    "nx": {
        "name": "synapse-runtime"
    },
    "dependencies": {
        "@pixel-brewery/synapse-core": "^0.0.4",
        "ajv": "8.20.0",
        "cross-spawn": "7.0.6"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.15.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "description": "Bounded CLI execution, streaming, workspaces, cancellation and profile/session coordination for local AI applications.",
    "scripts": {
        "build": "tsc --build tsconfig.lib.json",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
        "lint": "eslint src",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/cross-spawn": "6.0.6"
    },
    "keywords": [
        "ai",
        "cli",
        "typescript",
        "runtime",
        "streaming",
        "cancellation"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixel-brewery/synapse.git",
        "directory": "libs/synapse-runtime"
    },
    "homepage": "https://github.com/pixel-brewery/synapse#packages",
    "bugs": {
        "url": "https://github.com/pixel-brewery/synapse/issues"
    }
}
